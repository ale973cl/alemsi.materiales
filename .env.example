# URL pública del proyecto Supabase usada por clientes y servidor.
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública/publishable de Supabase usada por @supabase/ssr en navegador y servidor.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL base pública de la aplicación para construir enlaces absolutos fuera de Vercel.
NEXT_PUBLIC_APP_URL=

# URL privada/opcional de Supabase usada por el generador de respaldos; si falta usa NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=

# Clave service role de Supabase para procesos internos privilegiados como respaldos, correo y conteo por token.
SUPABASE_SERVICE_ROLE_KEY=

# Clave manual exigida por el endpoint de respaldo de Admin Total.
BACKUP_ADMIN_TOKEN=

# Token Bearer que protege el worker HTTP que procesa la cola de correos.
EMAIL_WORKER_TOKEN=

# Servidor SMTP utilizado por el motor de correo.
SMTP_SERVER=

# Puerto TCP del servidor SMTP.
SMTP_PORT=

# Cuenta remitente y usuario de autenticación SMTP.
EMAIL_USER=

# Contraseña o clave de aplicación de la cuenta SMTP.
EMAIL_PASS=

# Clave de OpenAI utilizada por el reconocimiento estructurado de facturas.
OPENAI_API_KEY=

# Modelo de OpenAI para reconocimiento de facturas; si falta usa el valor por defecto definido en el código.
OPENAI_INVOICE_MODEL=

# URL de la rama Preview inyectada automáticamente por Vercel; se documenta porque el código la consulta.
VERCEL_BRANCH_URL=

# URL del deployment inyectada automáticamente por Vercel; se documenta porque el código la consulta.
VERCEL_URL=


# Lector visual reutilizado por Rendiciones y Flota. Gemini también procesa los PDF de Flota.
GEMINI_API_KEY=
GEMINI_RECEIPT_MODEL=

# Respaldo visual para imágenes cuando Gemini no está disponible. No se usa como respaldo de PDF.
OPENROUTER_API_KEY=

# URL pública opcional enviada como referencia al proveedor de respaldo.
NEXT_PUBLIC_SITE_URL=
